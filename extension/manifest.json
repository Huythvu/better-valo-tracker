{
  "manifest_version": 3,
  "name": "Better Valo Tracker",
  "version": "1.0.0",
  "description": "Track Valorant rank, RR, peak, and recent matches across your grind accounts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Valo Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*.workers.dev/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
