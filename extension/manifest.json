{
  "manifest_version": 3,
  "name": "Better Valo Tracker",
  "version": "1.2.5",
  "description": "Track Valorant rank, RR, peak, and recent matches across your grind accounts.",
  "action": {
    "default_title": "Better Valo Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "api.js",
        "ranks.js",
        "popup.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.workers.dev/*",
    "https://valorant-api.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
