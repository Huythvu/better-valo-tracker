{
  "manifest_version": 3,
  "name": "Better Valo Tracker",
  "version": "1.0.0",
  "description": "Track Valorant rank, RR, peak, and recent matches across your grind accounts.",
  "action": {
    "default_title": "Better Valo Tracker"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": ["https://*.workers.dev/*", "https://valorant-api.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
